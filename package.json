{
  "name": "car-labs-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/src/server/index.js",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:validate": "tsx scripts/validate-car-data.ts",
    "data:build": "tsx scripts/build-car-database.ts",
    "data:integrity": "tsx scripts/check-car-data-integrity.ts",
    "data:import": "tsx scripts/import-car-data.ts",
    "data:check": "tsx scripts/check-car-data-integrity.ts",
    "qa:release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run data:validate && npm run data:integrity"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
